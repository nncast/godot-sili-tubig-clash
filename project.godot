GameSettings="*res://autoloads/game_settings.gd"
SightingTracker="*res://autoloads/sighting_tracker.gd"
AudioManager="*res://autoloads/audio_manager.gd"
SeriesManager="*res://autoloads/series_manager.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="uid://c2ckxx3t7ukq4"

